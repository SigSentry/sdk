{
  "name": "@sigsentry/core",
  "version": "0.1.0",
  "description": "SigSentry core SDK — TypeScript API client, types, and utilities for AI-powered log analysis",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": ["sigsentry", "traceback", "log-analysis", "ai", "api-client", "sdk"],
  "homepage": "https://sigsentry.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/SigSentry/sdk",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/SigSentry/sdk/issues"
  }
}
